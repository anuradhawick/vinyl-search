              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"chosenImage\":0,\"images\":[\"{{tempRecordImageUrl1}}\",\"{{tempRecordImageUrl2}}\"],\"date\":\"1993-12-31\",\"genres\":[\"African\",\"Asian\"],\"styles\":[\"Alternative Country\",\"Traditional Country Music\"],\"descriptions\":[\"Album\",\"Special Edition\"],\"speed\":\"33 1/3 RPM\",\"size\":\"LP\",\"country\":\"Sri Lanka\",\"tracks\":[{\"index\":\"1\",\"artists\":[{\"index\":1,\"name\":\"Artist Name 1\"}],\"title\":\"Song 1\",\"credits\":[{\"index\":1,\"text\":\"Credits 1\"}],\"duration\":\"5:00\"},{\"index\":\"2\",\"artists\":[{\"index\":1,\"name\":\"Artist Name 2\"}],\"title\":\"Song 2\",\"credits\":[{\"index\":1,\"text\":\"Credits 2\"}],\"duration\":\"4:00\"}],\"notes\":\"Example notes for the release.\",\"commonCredits\":[{\"index\":1,\"text\":\"Produced by Example Producer\"}],\"songUrls\":[{\"index\":1,\"text\":\"https://example.com/track/1\"}],\"name\":\"Test Title\",\"label\":\"Sakura\",\"mainArtist\":\"Test Artist\",\"catalogNo\":\"CAT_4569:123\",\"format\":\"Shellac\",\"channelCoding\":\"Stereo\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/records",
            "description": "Comprehensive example matching the record editor payload. Replace temp image URLs with real uploaded temp objects before sending."
          },
          "response": []
        },
        {
          "name": "Update record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id\":\"{{recordId}}\",\"ownerUid\":\"{{userUid}}\",\"chosenImage\":1,\"images\":[\"{{existingRecordImageUrl}}\",\"{{tempRecordImageUrl3}}\"],\"date\":\"1993-12-31\",\"genres\":[\"African\",\"Asian\"],\"styles\":[\"Alternative Country\",\"Traditional Country Music\"],\"descriptions\":[\"Album\",\"Special Edition\"],\"speed\":\"33 1/3 RPM\",\"size\":\"LP\",\"country\":\"Sri Lanka\",\"tracks\":[{\"index\":\"1\",\"artists\":[{\"index\":1,\"name\":\"Artist Name 1\"}],\"title\":\"Song 1\",\"credits\":[{\"index\":1,\"text\":\"Credits 1\"}],\"duration\":\"5:00\"}],\"notes\":\"Expanded notes for the revised release.\",\"commonCredits\":[{\"index\":1,\"text\":\"Produced by Example Producer\"}],\"songUrls\":[{\"index\":1,\"text\":\"https://example.com/track/1\"}],\"name\":\"Test Title (Revised)\",\"label\":\"Sakura\",\"mainArtist\":\"Test Artist\",\"catalogNo\":\"CAT_4569:123\",\"format\":\"Shellac\",\"channelCoding\":\"Stereo\",\"revisionComments\":\"Corrected the label details and refreshed the images.\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/records/{{recordId}}",
            "description": "Creates a new latest revision. The body mirrors the edit flow, including `id`, `ownerUid`, and `revisionComments`."
          },
          "response": []
        },
        {
          "name": "List record revisions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/records/{{recordId}}/revisions",
            "description": "Returns revision metadata for one logical record."
          },
          "response": []
        },
        {
          "name": "Get record revision",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/records/{{recordId}}/revisions/{{recordRevisionId}}",
            "description": "Returns a single historical revision."
          },
          "response": []
        }
      ]
    },
