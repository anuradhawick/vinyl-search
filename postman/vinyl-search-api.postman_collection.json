  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "Returns the authenticated user profile."
          },
          "response": []
        },
        {
          "name": "Update profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"given_name\":\"Anuradha\",\"family_name\":\"Wickramasinghe\",\"picture\":\"{{profilePictureUrl}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users",
            "description": "Matches the frontend profile update payload. You can also send just `picture`, or just `given_name` + `family_name`."
          },
          "response": []
        },
        {
          "name": "List my records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/records?limit=10&skip=0",
            "description": "Lists records owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Delete my record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/records/{{recordId}}",
            "description": "Deletes all revisions for the logical record."
          },
          "response": []
        },
        {
          "name": "List my forum posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/forum?limit=10&skip=0",
            "description": "Lists forum posts owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Delete my forum post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/forum/{{forumPostId}}",
            "description": "Deletes one of the authenticated user's forum posts."
          },
          "response": []
        },
        {
          "name": "List my market posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/market?limit=10&skip=0",
            "description": "Lists marketplace ads owned by the authenticated user."
          },
          "response": []
        },
        {
          "name": "Delete my market post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
